# Supabase proje adresi ve herkese açık (publishable/anon) anahtar.
# Bu anahtar tarayıcıda bulunması için tasarlanmıştır; veriler RLS ile korunur.
# SERVICE ROLE anahtarını ASLA buraya veya frontend koduna koymayın.
VITE_SUPABASE_URL=https://<proje-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-veya-anon-anahtar>

# (İsteğe bağlı) Giriş gerektiren E2E testleri için test hesabı
E2E_BASE_URL=http://localhost:5173
E2E_EMAIL=
E2E_PASSWORD=
